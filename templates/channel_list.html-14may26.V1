{% extends "base.html" %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark"><i class="fas fa-satellite-dish text-primary me-2"></i>Inventario de Canales</h3>
    
    <div class="d-flex gap-2 shadow-sm rounded">

        <!-- <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Buscar canal, IP..." autocomplete="off">
        </div> -->
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" id="searchChannelInput" class="form-control border-start-0" placeholder="Buscar canal, IP..." autocomplete="off">
        </div>

        <a href="/ui/channels/new" class="btn btn-primary text-nowrap fw-bold">
            <i class="fas fa-plus-circle me-2"></i>Nuevo Canal
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 bg-white" id="channelsTable">
            <thead class="table-light border-bottom border-2">
                <tr>
                    <th onclick="sortTable(0, 'num')" style="cursor: pointer;" class="text-muted"><i class="fas fa-sort me-1"></i>ID</th>
                    <th onclick="sortTable(1, 'str')" style="cursor: pointer;" class="text-muted"><i class="fas fa-sort me-1"></i>Canal / Unique ID</th>
                    <th onclick="sortTable(2, 'str')" style="cursor: pointer;" class="text-muted"><i class="fas fa-sort me-1"></i>Despliegue Físico (Estado)</th>
                    <th class="text-muted">Input Mcast (Origen)</th>
                    <th class="text-muted">Output Mcast (Destino)</th>
                    <th class="text-end text-muted">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for c in channels %}
                <tr class="searchable-row">
                    <td class="fw-bold text-secondary">{{ c.id }}</td>
                    
                    <td>
                        <span class="fw-bold text-dark fs-6">{{ c.channel_name }}</span><br>
                        <small class="text-muted font-monospace"><i class="fas fa-hashtag me-1"></i>{{ c.unique_id }}</small>
                    </td>
                    
   <!--                  <td>
                        <div class="d-flex flex-column gap-1">
                            {% set enc_job = None %}
                            {% set pkg_job = None %}
                            {% for j in c.jobs %}
                                {% if j.node.tipo == 'Encoder' %}{% set enc_job = j %}{% endif %}
                                {% if j.node.tipo == 'Packager' %}{% set pkg_job = j %}{% endif %}
                            {% endfor %}

                            {% if enc_job %}
                                <div class="d-flex align-items-center">
                                    {% if enc_job.status == 'running' %}
                                        <i class="fas fa-circle text-success me-2 heartbeat-icon" style="font-size: 0.7rem;" title="Corriendo"></i>
                                    {% elif enc_job.status == 'starting' %}
                                        <i class="fas fa-circle text-warning me-2" style="font-size: 0.7rem;" title="Iniciando"></i>
                                    {% else %}
                                        <i class="fas fa-circle text-danger me-2" style="font-size: 0.7rem;" title="Detenido / Error"></i>
                                    {% endif %}
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary me-2" style="width: 55px;">ENC</span>
                                    <small class="fw-bold text-secondary">{{ enc_job.node.hostname }}</small>
                                </div>
                            {% else %}
                                <div class="d-flex align-items-center opacity-50">
                                    <i class="fas fa-circle text-secondary me-2" style="font-size: 0.7rem;"></i>
                                    <span class="badge bg-light text-secondary border me-2" style="width: 55px;">ENC</span>
                                    <small class="text-muted fst-italic">Sin asignar</small>
                                </div>
                            {% endif %}

                            {% if pkg_job %}
                                <div class="d-flex align-items-center">
                                    {% if pkg_job.status == 'running' %}
                                        <i class="fas fa-circle text-success me-2 heartbeat-icon" style="font-size: 0.7rem;" title="Corriendo"></i>
                                    {% elif pkg_job.status == 'starting' %}
                                        <i class="fas fa-circle text-warning me-2" style="font-size: 0.7rem;" title="Iniciando"></i>
                                    {% else %}
                                        <i class="fas fa-circle text-danger me-2" style="font-size: 0.7rem;" title="Detenido / Error"></i>
                                    {% endif %}
                                    <span class="badge bg-warning bg-opacity-25 text-dark border border-warning me-2" style="width: 55px;">PKG</span>
                                    <small class="fw-bold text-secondary">{{ pkg_job.node.hostname }}</small>
                                </div>
                            {% else %}
                                <div class="d-flex align-items-center opacity-50">
                                    <i class="fas fa-circle text-secondary me-2" style="font-size: 0.7rem;"></i>
                                    <span class="badge bg-light text-secondary border me-2" style="width: 55px;">PKG</span>
                                    <small class="text-muted fst-italic">Sin asignar</small>
                                </div>
                            {% endif %}
                        </div>
                    </td> -->

                    <td>
                        <div class="d-flex flex-column gap-1">
                            {% set ns = namespace(enc_job=None, pkg_job=None) %}
                            {% for j in c.jobs %}
                                {% if j.node.tipo == 'Encoder' %}{% set ns.enc_job = j %}{% endif %}
                                {% if j.node.tipo == 'Packager' %}{% set ns.pkg_job = j %}{% endif %}
                            {% endfor %}

                            {% if ns.enc_job %}
                                <div class="d-flex align-items-center">
                                    {% if ns.enc_job.status == 'running' %}
                                        <i class="fas fa-circle text-success me-2 heartbeat-icon" style="font-size: 0.7rem;" title="Corriendo"></i>
                                    {% elif ns.enc_job.status == 'starting' %}
                                        <i class="fas fa-circle text-warning me-2" style="font-size: 0.7rem;" title="Iniciando"></i>
                                    {% else %}
                                        <i class="fas fa-circle text-danger me-2" style="font-size: 0.7rem;" title="Detenido / Error"></i>
                                    {% endif %}
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary me-2" style="width: 45px;">ENC</span>
                                    <small class="fw-bold text-secondary">{{ ns.enc_job.node.hostname }}</small>
                                </div>
                            {% else %}
                                <div class="d-flex align-items-center opacity-50">
                                    <i class="fas fa-circle text-secondary me-2" style="font-size: 0.7rem;"></i>
                                    <span class="badge bg-light text-secondary border me-2" style="width: 45px;">ENC</span>
                                    <small class="text-muted fst-italic">Sin asignar</small>
                                </div>
                            {% endif %}

                            {% if ns.pkg_job %}
                                <div class="d-flex align-items-center">
                                    {% if ns.pkg_job.status == 'running' %}
                                        <i class="fas fa-circle text-success me-2 heartbeat-icon" style="font-size: 0.7rem;" title="Corriendo"></i>
                                    {% elif ns.pkg_job.status == 'starting' %}
                                        <i class="fas fa-circle text-warning me-2" style="font-size: 0.7rem;" title="Iniciando"></i>
                                    {% else %}
                                        <i class="fas fa-circle text-danger me-2" style="font-size: 0.7rem;" title="Detenido / Error"></i>
                                    {% endif %}
                                    <span class="badge bg-warning bg-opacity-25 text-dark border border-warning me-2" style="width: 45px;">PKG</span>
                                    <small class="fw-bold text-secondary">{{ ns.pkg_job.node.hostname }}</small>
                                </div>
                            {% else %}
                                <div class="d-flex align-items-center opacity-50">
                                    <i class="fas fa-circle text-secondary me-2" style="font-size: 0.7rem;"></i>
                                    <span class="badge bg-light text-secondary border me-2" style="width: 45px;">PKG</span>
                                    <small class="text-muted fst-italic">Sin asignar</small>
                                </div>
                            {% endif %}
                        </div>
                    </td>



                    <td>
                        <span class="badge bg-light text-dark border font-monospace px-2 py-1"><i class="fas fa-sign-in-alt text-muted me-1"></i>{{ c.origin_multicast_ip }}:{{ c.origin_multicast_port }}</span>
                        {% if c.origin_count == 2 %}
                        <br><span class="badge bg-danger bg-opacity-10 text-danger border border-danger font-monospace px-2 py-1 mt-1"><i class="fas fa-random me-1"></i>Respaldo Activo</span>
                        {% endif %}
                    </td>
                    
                    <td>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success font-monospace px-2 py-1"><i class="fas fa-sign-out-alt me-1"></i>{{ c.multicast_ip_out }}</span>
                    </td>
                    
                    <td class="text-end">
                        <a href="/ui/channels/edit/{{ c.id }}" class="btn btn-sm btn-outline-primary shadow-sm" title="Editar Canal"><i class="fas fa-edit"></i> Editar</a>
                        <a href="/ui/channels/delete/{{ c.id }}" class="btn btn-sm btn-outline-danger shadow-sm ms-1" onclick="return confirm('¿Peligro: Desea borrar este canal del inventario?')" title="Eliminar"><i class="fas fa-trash"></i></a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center py-5 text-muted"><i class="fas fa-inbox fa-3x mb-3 opacity-25"></i><br>No hay canales configurados en el inventario.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<style>
    @keyframes heartbeat {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.7; }
        100% { transform: scale(1); opacity: 1; }
    }
    .heartbeat-icon { animation: heartbeat 2s infinite ease-in-out; }
    th:hover { background-color: #f8f9fa !important; }
</style>

<script>
// Filtro de búsqueda rápida
document.addEventListener("DOMContentLoaded", function() {
    // Usamos el nuevo ID que definiste en el HTML arriba
    const searchInput = document.getElementById('searchChannelInput');
    
    if (searchInput) {
        searchInput.addEventListener('keyup', function() {
            const filter = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('.searchable-row');
            
            rows.forEach(function(row) {
                // Usamos innerText para buscar el texto exactamente como se ve en pantalla
                const text = row.innerText.toLowerCase();
                if (text.includes(filter)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    }
});

// Función de Ordenamiento por Columnas
function sortTable(n, type) {
    var table, rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
    table = document.getElementById("channelsTable");
    switching = true;
    dir = "asc"; 
    while (switching) {
        switching = false;
        rows = table.rows;
        for (i = 1; i < (rows.length - 1); i++) {
            shouldSwitch = false;
            x = rows[i].getElementsByTagName("TD")[n];
            y = rows[i + 1].getElementsByTagName("TD")[n];
            
            let valX = type === 'num' ? parseInt(x.innerText.trim()) || 0 : x.innerText.toLowerCase().trim();
            let valY = type === 'num' ? parseInt(y.innerText.trim()) || 0 : y.innerText.toLowerCase().trim();
            
            if (dir == "asc") {
                if (valX > valY) { shouldSwitch = true; break; }
            } else if (dir == "desc") {
                if (valX < valY) { shouldSwitch = true; break; }
            }
        }
        if (shouldSwitch) {
            rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
            switching = true;
            switchcount ++;
        } else {
            if (switchcount == 0 && dir == "asc") {
                dir = "desc";
                switching = true;
            }
        }
    }
}
</script>
{% endblock %}